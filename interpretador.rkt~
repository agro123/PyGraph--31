; 3. Parser, Scanner, Interfaz

;El FrontEnd (Análisis léxico (scanner) y sintáctico (parser) integrados)
(define scan&parse
  (sllgen:make-string-parser scanner-spec grammar)) ;;Convertir de concreta a abstracta



;El Analizador Léxico (Scanner)
(define just-scan
  (sllgen:make-string-scanner scanner-spec grammar)) ;; Visualizar los tokens

;Entrada de texto del interpretador
(define interpreter
  (sllgen:make-rep-loop  "--> "
    (lambda (pgm) (eval-program  pgm))
    (sllgen:make-stream-parser scanner-spec grammar)))

;******************************************************************************************* Interprete

;;Ambiente inicial
(define init-env
  (lambda ()
    (extend-env
     '(@PI)
     '(3.14159265359)
     (empty-enviroment))))

;;Evaluar programa
(define eval-program
  (lambda (pgm)
    (cases program pgm
      (un-program (body)
                   (eval-expression body (init-env)))
      (else (eopl:error "ERROR")))))

;;Evaluar expresion
(define eval-expression
  (lambda (exp env)
    (cases expression exp
      ;;Datos
      (number-lit (num) num)
      (char-lit (char) char)
      (text-lit (txt) txt)
      (bool-true-lit () #t)
      (bool-false-lit () #f)

      ;;Evaluar Identificadores
      (var-exp (id) (find-var env id))

      ;;Evaluar Definiciones
      (variable-exp (ids exps body)
                    (let ((args (list-exps exps env)))
                         (eval-expression body (extend-env-var ids args env))))
      (const-exp (ids exps body)
                 (let ((args (list-exps exps env)))
                      (eval-expression body (extend-env ids args env))))
      (rec-exp (procNames procParams procBodies exp)
               (eval-expression exp
                                (extend-env-rec procNames procParams procBodies env)))

      ;;Evaluar primitivas
      (primapp-bin-exp (exp1 prim-binaria exp2) ((eval-binPrim prim-binaria) (eval-expression exp1 env) (eval-expression exp2 env)))
      (primapp-un-exp (prim-unaria exp) ((eval-unaPrim prim-unaria) (eval-expression exp env)))

      ;;Evaluar listas
      (list-exp (exps) (eval-list exps env))
      (primapp-list-exp (prim exp) ((eval-prim-list prim) (eval-expression exp env)))
      (primbin-list-exp (prim exps) ((eval-bin-prim-list prim) (list-exps exps env)))

      ;;Evaluar vectores
      (vector-exp (exps) (eval-vector exps env))
      (prim-vector-exp (prim exps) (eval-prim-vector prim exps env))

      ;;Evaluar registros
      (record-exp (exps) (eval-record exps env))
  
      ;;Evaluar booleanos
      (bool-exp (exp) (eval-boolean exp env))

      ;;Evaluar estructuras de control
      (set-exp (id new-exp)
               (begin
                  (setref!
                          (find-var-to-set env id)
                          (eval-expression new-exp env))
                   1))
      (begin-exp (exp exps) 
                 (let loop ((acc (eval-expression exp env)) (exps exps))
                      (if (null? exps) 
                           acc
                          (loop (eval-expression (car exps) env)
                                (cdr exps)))))
      (if-exp (pred-exp true-exp false-exp)
              (if (eval-boolean pred-exp env)
                  (eval-expression true-exp env)
                  (eval-expression false-exp env)))
      
      (proc-exp (ids cuerpo) (cerradura ids cuerpo env))
      (app-exp (exp exps)
               (let ((proc (eval-expression exp env))
                     (args (list-exps exps env)))
                 (if (procVal? proc)
                     (aplicar-proc proc args)
                     (eopl:error 'eval-expression
                                 "Attempt to apply non-procedure ~s"))))
      (print-exp (exp)(begin (eopl:printf "~v"  (eval-expression exp env)) '-log))
      (while-do-exp (expbool exp) (begin
                                    (while-do expbool exp env)
                                    1))
      (for-to-exp (id fromValue toValue body) (let ((fv (eval-expression fromValue env)) (tv (eval-expression toValue env)))
                                                (if (and (number? fv)(number? tv))
                                                    (begin (for-to id
                                                              fv
                                                              tv
                                                              body
                                                              (extend-env-var (list id) (list fv) env)) 1)
                                                (eopl:error "ERROR el valor inicial y final deben ser numeros"))))

      (else (eopl:error "ERROR eval-expression"))
      )))
;***************************************************************************************** Listas
;;Evaluar lista
(define eval-list
  (lambda (lst env)
    (cases expr-list lst
      (empty-list () '())
      (list-lit (exps) (list-exps exps env))
      (else (eopl:error "ERROR eval-list")))))
;;Evaluar primitivas sobre listas
(define eval-prim-list
  (lambda (prim)
    (cases prim-list prim
      (prim-list-empty? () (lambda (lst) (if (list? lst) (eqv? empty lst) (eopl:error 'prim-list-empty? "Error, esta operacion solo permite listas"))))
      (prim-list-car () (lambda (lst) (if (list? lst) (car lst) (eopl:error 'prim-list-car "Error, esta operacion solo permite listas"))))
      (prim-list-cdr () (lambda (lst) (if (list? lst) (cdr lst) (eopl:error 'prim-list-cdr "Error, esta operacion solo permite listas"))))
      (prim-list-list? () (lambda (lst) (list? lst)))
      (else (eopl:error "ERROR eval-prim-list")))))

(define eval-bin-prim-list
  (lambda (prim)
    (cases prim-bin-list prim
      (prim-list-append () (lambda (lst) (if ((list-of list?) lst) (apply append lst) (eopl:error 'prim-list-append "Error, esta operacion solo permite listas"))))
      (prim-list-make () (lambda (values) (apply list values)));Crea una lista con los valores dados
      (else (eopl:error "ERROR eval-bin-prim-list")))))

;***************************************************************************************** Vectores
;;Evaluar vector
(define eval-vector
  (lambda (vec env)
    (cases expr-vector vec
      (vector-lit (exps) (apply vector (list-exps exps env)))
      (else (eopl:error "ERROR eval-vector")))))

;;Evaluar primitivas sobre Vectores *Recibe una lista de expresiones pero solo evalua las expresiones necesarias para cada primitiva
(define eval-prim-vector
  (lambda (prim exps env)
    (cases prim-vector prim
      (prim-vector-vector? () (vector? (eval-expression (car exps) env)))
      (prim-vector-make () (let ((np (eval-expression (car exps) env))); numero de posiciones
                                (if (and (number? np) (> np 0))
                                    (make-vector np)
                                    (eopl:error 'prim-vector-make "Error, parametros no validos"))))
      (prim-vector-set () (let ((vec (eval-expression (car exps) env)); vector
                                (pos (eval-expression (car (cdr exps)) env)) ; pos
                                (val (eval-expression (car (cddr exps)) env))) ; valor
                                (if (and (vector? vec) (number? pos))
                                    (begin (vector-set! vec pos val) 1)
                                    (eopl:error 'prim-vector-set "Error,  parametros no validos"))))
      (prim-vector-ref () (let ((vec (eval-expression (car exps) env)); vector
                                (pos (eval-expression (car (cdr exps)) env))) ; pos
                                (if (and (vector? vec) (number? pos))
                                    (vector-ref vec pos)
                                    (eopl:error 'prim-vector-ref "Error,  parametros no validos"))))
      (else (eopl:error "ERROR prim-vector-vector?")))))

;***************************************************************************************** Registros

;Datatype registro
(define-datatype record record?
  (record-value (keys (list-of symbol?))
                (values vector?)))

;;Evaluar registros
(define eval-record
  (lambda (exps env)
    (cases expr-record exps
      (record-lit (fkey fvalue rkeys rvalues) (let ((keys (append (list fkey) rkeys));Unir la primera key con el resto de keys
                                                    (values (list-exps (append (list fvalue) rvalues) env)));evaluar exps
                                                   (record-value keys (list->vector values) )))
      (prim-record-vector? (exp) (record? (eval-expression exp env)))
      (prim-record-set (rec key newVal) (let ((rc (eval-expression rec env)); registro
                                              (val (eval-expression newVal env))) ; nuevo valor
                                             (if (and (record? rc) (symbol? key))
                                                 (set-record-value rc key val)
                                                 (eopl:error 'prim-record-set "Error,  parametros no validos"))))
      (prim-record-ref (rec key) (let ((rc (eval-expression rec env))); registro
                                      (if (and (record? rc) (symbol? key))
                                          (find-record-value rc key)
                                          (eopl:error 'prim-record-ref "Error,  parametros no validos"))))
      (else  (eopl:error "ERROR eval-record")))))

;;Setear un nuevo valor en registro
(define set-record-value
  (lambda (rec key newVal)
    (cases record rec
      (record-value (keys values) (let* ((pos (list-find-position key keys)))
                                    (if (number? pos)
                                        (begin
                                              (vector-set! values pos newVal)
                                              1)
                                        (eopl:error "La key ~s no esta en registro" key))))
      (else (eopl:error "ERROR set-record-value")))))
;;Buscar la posicion de la key en el registro
(define find-record-value
  (lambda (rec key)
    (cases record rec
      (record-value (keys values) (let ((pos (list-find-position key keys)))
                                    (if (number? pos)
                                        (vector-ref values pos)
                                        (eopl:error "La key ~s no esta en registro" key))))
      (else (eopl:error "ERROR find-record-value")))))

    
;***************************************************************************************** Booleanos

;;Evaluar expresion booleana
(define eval-boolean
  (lambda (bool env)
    (cases expr-bool bool
      (pred-bin-exp (pred exp1 exp2) ((eval-pred-binary pred) (eval-expression exp1 env) (eval-expression exp2 env)))
      (pred-un-exp (pred exp1) ((eval-pred-unary pred) (eval-boolean exp1 env)))
      (else (eopl:error "ERROR eval-boolean")))))

;;Evaluar predicado binario
(define eval-pred-binary
  (lambda (pred)
    (cases oper-bin-bool pred
      (pred-igualdad () (lambda (val1 val2) (equal? val1 val2)))
      (pred-diferencia () (lambda (val1 val2) (not (equal? val1 val2))))
      (pred-mayor-que () (lambda (val1 val2) (> val1 val2)))
      (pred-menor-que () (lambda (val1 val2) (< val1 val2)))
      (pred-mayor-igual-que () (lambda (val1 val2) (>= val1 val2)))
      (pred-menor-igual-que () (lambda (val1 val2) (<= val1 val2)))
      (pred-and () (lambda (val1 val2) (and val1 val2)))
      (pred-or () (lambda (val1 val2) (or val1 val2)))
      (else (eopl:error "ERROR eval-pred-binary")))))

;;Evaluar predicado binario
(define eval-pred-unary
  (lambda (pred)
    (cases oper-un-bool pred
      (pred-not () (lambda (val) (not val)))
      (else (eopl:error "ERROR eval-pred-unary")))))
;****************************************************************************************** Primitivas
  
;obtener la operacion de  primitiva binaria
(define eval-binPrim 
  (lambda (prim)
    (cases prim-binary prim
      (primitiva-suma () (lambda (val1 val2) (if (and (number? val1) (number? val2)) (+ val1 val2) (eopl:error 'primitiva-suma "Error, esta operacion solo permite numeros"))))
      (primitiva-resta () (lambda (val1 val2) (if (and (number? val1) (number? val2)) (- val1 val2) (eopl:error 'primitiva-resta "Error, esta operacion solo permite numeros"))))
      (primitiva-div () (lambda (val1 val2) (if (and (number? val1) (number? val2)) (/ val1 val2) (eopl:error 'primitiva-div "Error, esta operacion solo permite numeros"))))
      (primitiva-multi () (lambda (val1 val2) (if (and (number? val1) (number? val2)) (* val1 val2) (eopl:error 'primitiva-multi "Error, esta operacion solo permite numeros"))))
      (primitiva-res () (lambda (val1 val2) (if (and (number? val1) (number? val2)) (remainder val1 val2) (eopl:error 'primitiva-res "Error, esta operacion solo permite numeros"))))
      (primitiva-concat () concat)
      (else (eopl:error "ERROR eval-binPrim")))))

;obtener la operacion de  primitiva unaria
(define eval-unaPrim 
  (lambda (prim)
    (cases prim-unary prim
      (primitiva-longitud () (lambda (val) (if (string? val) (string-length val) (eopl:error 'longitud "Error, el valor no es una cadena de texto"))))
      (primitiva-add1 () (lambda (val) (if (number? val) (+ val 1) (eopl:error 'add1 "Error, el valor no es un numero"))))
      (primitiva-sub1 () (lambda (val) (if (number? val) (- val 1) (eopl:error 'sub1 "Error, el valor no es un numero"))))
      (else (eopl:error "ERROR"))
      )))
;******************************************************************************************* Ambientes
;Para cualquier valor de scheme retorna true
(define scheme-value? (lambda (v) #t))

;datatype de ambiente
(define-datatype environment environment?
  (empty-env)

  ;;Ambiente para constantes
  (extended-env (ids (list-of symbol?))
                (exps (list-of scheme-value?))
                (env environment?))
  ;;Ambiente para recursion
  (rec-env  (procNames (list-of symbol?))
            (procParams (list-of (list-of symbol?)))
            (procBodies (list-of expression?))
            (old-env environment?))
  ;;Ambiente para variables
  (var-env (ids (list-of symbol?))
           (exps vector?)
           (env environment?)))

;Ambiente vacío
(define empty-enviroment
  (lambda ()
    (empty-env)))

;Extender ambiente constantes
(define extend-env
  (lambda (syms vals env)
    (extended-env syms vals env)))

;Extender ambiente recursion
(define extend-env-rec
  (lambda (procNames procParams procBodies old-env)
    (rec-env procNames procParams procBodies old-env)))

;Extender ambiente variables
(define extend-env-var
  (lambda (ids exps env)
    (var-env ids (list->vector exps) env)))

;Buscar un identificador en un ambiente
(define find-var ;;apply-env
  (lambda (env id)
    (cases environment env
      (empty-env () (eopl:error 'find-var "Error, la variable ~s no existe" id))
      (extended-env (ids exps env)
                           (let ((pos (list-find-position id ids)))
                             (if (number? pos)
                                 (list-ref exps pos)
                                 (find-var env id))))
      (rec-env (procNames procParams procBodies old-env)
                             (let ((pos (list-find-position id procNames)))
                                         (if (number? pos)
                                             (cerradura (list-ref procParams pos)
                                                        (list-ref procBodies pos)
                                                         env)
                                             (find-var old-env id))))
      (var-env (ids exps env)
                           (let ((pos (list-find-position id ids)))
                             (if (number? pos)
                                 (deref (a-ref pos exps))
                                 (find-var env id)))))))
;;Buscar una variable para ser modificada
(define find-var-to-set ;;apply-env-ref
  (lambda (env id)
    (cases environment env
      (empty-env () (eopl:error 'find-var "Error, la variable ~s no existe " id))
      
      (extended-env (ids exps env)
                           (let ((pos (list-find-position id ids)))
                             (if (number? pos)
                                 (eopl:error 'find-var "Error, La constante ~s no puede ser modificada " id);; si la variable a modificar es una constante retorna un error
                                 (find-var-to-set env id))))
      (rec-env (procNames procParams procBodies old-env)
                             (let ((pos (list-find-position id procNames)))
                                         (if (number? pos)
                                             (eopl:error 'find-var "Error, El procemiento recursivo ~s no puede ser modificado" id);; si la variable a modificar es un procedimiento recursivo retorna un error
                                             (find-var old-env id))))
      (var-env (ids exps env)
                           (let ((pos (list-find-position id ids)))
                             (if (number? pos)
                                 (a-ref pos exps)
                                 (find-var-to-set env id)))))))
;*******************************************************************************************Referencias

;;Datatype referencia
(define-datatype reference reference?
  (a-ref (position integer?)
         (vec vector?)))

(define deref
  (lambda (ref)
    (primitive-deref ref)))

;;obtener el valor de la referencia
(define primitive-deref
  (lambda (ref)
    (cases reference ref
      (a-ref (pos vec)
             (vector-ref vec pos)))))
;;cambiar el valor de la referencia
(define setref!
  (lambda (ref val)
    (primitive-setref! ref val)))

(define primitive-setref!
  (lambda (ref val)
    (cases reference ref
      (a-ref (pos vec)
             (vector-set! vec pos val)))))

;******************************************************************************************* Procedimientos
;Datatype Procedemiento
(define-datatype procVal procVal?
  (cerradura
   (lista-ID (list-of symbol?))
   (exp expression?)
   (amb environment?)))

;Evalua las expresiones de un procedimiento en el ambiente extendido correspondiente
(define aplicar-proc
  (lambda (proc args)
    (cases procVal proc
      (cerradura (ids body env)
               (eval-expression body (extend-env ids args env))))))
;*******************************************************************************************iteracion
;while-do
(define while-do
  (lambda (cond body env)
    (when (eval-boolean cond env)
      (eval-expression body env);Evaluar expresion
      (while-do cond body env))))

;for
(define for-to
  (lambda (id initialValue finalValue body env)
    (let ((op (select-op initialValue finalValue)))  ;La operacion puede ser suma o resta, si es valor final es mayor al inicial, suma; si no, resta.
      (unless (equal? (find-var env id) finalValue) ;Si el valor inicial no es igual al final se ejecutara la expresion
        (eval-expression body env);;evaluar expresion
        (eval-expression (set-exp id (number-lit (op initialValue 1))) env) ;;Aumentar valor en 1
        (for-to id (op initialValue 1) finalValue body env)))))
;; si el numero inicial del for es menor al final se hara una suma por el contrario una resta
(define select-op
  (lambda (i f)
    (if (< i f)
        +
        -)))

;****************************************************************************************  Funciones Auxiliares
; busca la posición de un símbolo en la lista de símbolos de un ambiente
(define list-find-position
  (lambda (sym los)
    (list-index (lambda (sym1) (eqv? sym1 sym)) los)))


(define list-index
  (lambda (pred ls)
    (cond
      ((null? ls) #f)
      ((pred (car ls)) 0)
      (else (let ((list-index-r (list-index pred (cdr ls))))
              (if (number? list-index-r)
                (+ list-index-r 1)
                #f))))))

;Recibe dos valores y retorna una string con su concatenacion
(define concat
  (lambda (val1 val2)
    (cond
      [(number? val1) (concat (number->string val1) val2)]
      [(number? val2) (concat val1 (number->string val2))]
      [(and (string? val1) (string? val2)) (string-append val1 val2)]
      [else (eopl:error 'concat "Error, los valores no son numeros o cadenas")] )))

;Validar si una expresion es verdadera o falsa
(define valor-verdad?
  (lambda (x)
    (not (zero? x))))

;Validar cada expresion en una lista
(define list-exps
  (lambda (exps env)
    (if(eqv? exps empty)
       '()
        (cons (eval-expression (car exps) env) (list-exps (cdr exps) env)))))


